# Copy this file to ".env" (same folder) and fill in your own values.
# The real ".env" file is ignored by Git, so your passwords never reach GitHub.

# --- Django ---
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=paste-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Set to True only when the site is served over HTTPS (production)
SECURE_COOKIES=False

# --- Database (MySQL) ---
DB_ENGINE=mysql
DB_NAME=portfolio_manager
DB_USER=portfolio_user
DB_PASSWORD=your-mysql-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Optional: passwords used ONLY by "python manage.py seed_demo_data" ---
# If left empty, the defaults printed by that command are used (development only!)
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
